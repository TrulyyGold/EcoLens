{
  "name": "ecolens-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "generate:assets": "node assets/generate_assets.mjs",
    "postinstall": "node assets/generate_assets.mjs",
    "prestart": "node assets/generate_assets.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "preexport:android": "node assets/generate_assets.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.41",
    "expo-asset": "~11.0.5",
    "expo-camera": "~16.0.18",
    "expo-image-manipulator": "~13.0.6",
    "expo-image-picker": "~16.0.6",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "~18.3.12",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2"
  }
}
