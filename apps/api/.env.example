# Safe default: deterministic demo data, no external credentials required.
ECOLENS_MOCK_MODE=true
ENVIRONMENT=development

# Image and provider limits.
MAX_IMAGE_BYTES=10485760
ANALYSIS_TIMEOUT_SECONDS=20
GEMINI_MODEL=gemini-3.6-flash
# Required only when ECOLENS_MOCK_MODE=false.
GEMINI_API_KEY=

# Optional persistence. Prefer a service-role key on this trusted backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY may be used instead, subject to the RLS policies for that key/user.
SUPABASE_KEY=
SUPABASE_STORAGE_BUCKET=scan-images

# Comma-separated origins. Use explicit production origins outside local demos.
CORS_ORIGINS=*
